[Unit]
Description=Kursbuch Trading Dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=kursbuch
Group=kursbuch
WorkingDirectory=/opt/kursbuch/backend
EnvironmentFile=/etc/kursbuch/kursbuch.env
Environment=PYTHONUNBUFFERED=1
Environment=XDG_CACHE_HOME=/var/lib/kursbuch/cache
# Ein Worker: Cache, Login-Drosselung und SQLite liegen im Prozess.
ExecStart=/opt/kursbuch/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8710 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kursbuch
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
