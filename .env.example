# Lokale Entwicklung: als .env ins Projektverzeichnis kopieren.
# Hash erzeugen:  cd backend && python -m app.auth
DASHBOARD_PASSWORD_HASH=
SECRET_KEY=bitte-durch-zufallswert-ersetzen
# yahoo (echte Daten) oder demo (synthetisch, offline)
DATA_PROVIDER=yahoo
DATA_DIR=./var
# Lokal ohne HTTPS: 0
COOKIE_SECURE=0
SESSION_DAYS=14
