# /etc/apache2/sites-available/kursbuch.conf  –  __DOMAIN__ wird vom Installer ersetzt.
# Nur für die Subdomain; bestehende Sites (z. B. WordPress) bleiben unberührt.
# Den HTTPS-Block (*:443) erzeugt certbot automatisch (certbot --apache).
<VirtualHost *:80>
    ServerName __DOMAIN__

    ProxyPreserveHost On
    ProxyPass        / http://127.0.0.1:8710/
    ProxyPassReverse / http://127.0.0.1:8710/
    RequestHeader set X-Forwarded-Proto expr=%{REQUEST_SCHEME}

    LimitRequestBody 65536
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Frame-Options "DENY"

    ErrorLog ${APACHE_LOG_DIR}/kursbuch_error.log
    CustomLog ${APACHE_LOG_DIR}/kursbuch_access.log combined
</VirtualHost>
